# ============================================================================
# DEV'n DONE — configuration Apache / LiteSpeed (Hostinger)
# Copié tel quel dans build/ ; à envoyer avec le reste dans public_html/.
# ============================================================================

Options -Indexes
DirectoryIndex index.html
DirectorySlash On

# ---------------------------------------------------------------------------
# Redirections canoniques
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
	RewriteEngine On

	# HTTP → HTTPS (garde l'hôte demandé, pour que le staging reste sur son sous-domaine)
	RewriteCond %{HTTPS} !=on
	RewriteCond %{HTTP:X-Forwarded-Proto} !=https
	RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

	# www.devndone.com → devndone.com
	RewriteCond %{HTTP_HOST} ^www\.devndone\.com$ [NC]
	RewriteRule ^ https://devndone.com%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------------------------------------------------------------------------
# Page 404 statique (build/404/index.html), avec un vrai code HTTP 404
# ---------------------------------------------------------------------------
ErrorDocument 404 /404/index.html

# ---------------------------------------------------------------------------
# Types MIME
# ---------------------------------------------------------------------------
AddType font/woff2 .woff2
AddType application/manifest+json .webmanifest
AddType image/avif .avif
AddType image/webp .webp
AddType image/svg+xml .svg
AddDefaultCharset utf-8
AddCharset utf-8 .html .css .js .xml .txt .webmanifest .svg

# ---------------------------------------------------------------------------
# Cache
#  - HTML, sitemap, robots : toujours revalidés (déploiement visible immédiatement)
#  - Fichiers Vite hashés (_app/immutable) : 1 an, immuables
#  - Polices, logos, icônes : 30 jours
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
	<FilesMatch "\.(html|xml|txt|webmanifest)$">
		Header set Cache-Control "no-cache"
	</FilesMatch>

	# Noms Vite : nom.HASH.ext ou HASH.ext (hash de 8 caractères)
	<FilesMatch "(^|\.)[A-Za-z0-9_-]{8}\.(js|css|avif|webp|png|jpg|jpeg|svg|woff2)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>

	<FilesMatch "^(lilita-one|plus-jakarta-sans|ibm-plex-mono)[^/]*\.woff2$">
		Header set Cache-Control "public, max-age=2592000"
	</FilesMatch>

	<FilesMatch "^(logo-|favicon|apple-touch-icon|icon-|og-)[^/]*\.(svg|png|jpg)$">
		Header set Cache-Control "public, max-age=2592000"
	</FilesMatch>

	# -----------------------------------------------------------------------
	# Sécurité
	# La Content-Security-Policy principale est injectée par SvelteKit en <meta>
	# (empreintes des scripts). frame-ancestors n'est possible qu'en en-tête.
	# -----------------------------------------------------------------------
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
	Header always set X-Frame-Options "DENY"
	Header always set Content-Security-Policy "frame-ancestors 'none'"
	Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	Header always set Cross-Origin-Opener-Policy "same-origin"

	# HSTS : à activer UNIQUEMENT quand HTTPS fonctionne sur devndone.com ET www.
	# Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---------------------------------------------------------------------------
# Compression (LiteSpeed compresse aussi nativement)
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>

# Fichiers qui ne doivent jamais être servis s'ils arrivaient par erreur sur le serveur
<FilesMatch "(^\.env|\.map$|package(-lock)?\.json$|\.md$)">
	Require all denied
</FilesMatch>
